# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+asyncpg://routebridge:routebridge@localhost:5433/routebridge
# Optional: when set, pytest runs against this PostgreSQL database instead of SQLite.
DATABASE_URL_TEST=postgresql+asyncpg://routebridge:routebridge@localhost:5433/routebridge_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# dev | test | prod  (/docs and /openapi.json are open in dev, admin-only otherwise)
ENV=dev
# Rate limits (ADR-0008). One switch disables all of them; the test-suite and the load harness
# set it to false. See docs/decisions/0008-rate-limit-policy.md for why these numbers.
RATE_LIMIT_ENABLED=true
# POST /auth/login per client IP: a coarse anti-flood cap, wide enough for an office behind one
# NAT to sign in together.
LOGIN_RATE_LIMIT_PER_MINUTE=30
# POST /auth/login per submitted email: the account defence. Kept below the account-lockout
# threshold (10 failures) so the limit always bites before the lockout does, and refunded on a
# successful sign-in so only failures spend it.
LOGIN_EMAIL_RATE_LIMIT=5
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MINUTES=15
# POST /auth/refresh per client IP (no KDF on that path, so lenient).
REFRESH_RATE_LIMIT_PER_MINUTE=60
# POST /probe per user: the server dials a caller-named address, so this is what stops the
# endpoint being used as a slow port scanner.
PROBE_RATE_LIMIT_PER_MINUTE=10

# Automatic revocation of a suspicious device (ADR-0008, part two). A false revocation locks a
# real user out of their own machine, so raise rather than lower these; 0 disables one rule.
DEVICE_RISK_ENABLED=true
DEVICE_RISK_INTERVAL_SECONDS=300
DEVICE_RISK_WINDOW_MINUTES=60
DEVICE_RISK_SECRET_FAILURES=10
DEVICE_RISK_REFRESH_REUSE=3
