# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+asyncpg://routebridge:routebridge@localhost:5433/routebridge
# Optional: when set, pytest runs against this PostgreSQL database instead of SQLite.
DATABASE_URL_TEST=postgresql+asyncpg://routebridge:routebridge@localhost:5433/routebridge_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# dev | test | prod  (/docs and /openapi.json are open in dev, admin-only otherwise)
ENV=dev
# POST /auth/login limit: 5 requests/minute/IP. The test-suite sets this to false.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
