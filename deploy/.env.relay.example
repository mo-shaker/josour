# Josour relay (ADR-0009). Copy to .env on the relay host.

# Must be byte-identical to RELAY_SECRET on the control-plane API: the API mints the session
# tokens and the relay verifies them. Generate once with:  openssl rand -base64 48
# Deliberately NOT the same value as JWT_SECRET — that one signs user logins, and a relay is
# internet-facing by definition, so a breach there must not be able to mint access tokens.
RELAY_SECRET=

# The port clients dial. Keep 443 on a dedicated relay host; change it only when something else
# on the machine already holds 443 (running the relay beside the API for a first test).
RELAY_PUBLIC_PORT=443

LOG_LEVEL=INFO

# Deadlines (seconds)
PREAMBLE_TIMEOUT_SECONDS=5
PAIR_TIMEOUT_SECONDS=30
IDLE_TIMEOUT_SECONDS=120
MAX_SESSION_SECONDS=7200

# Limits. 0 for MAX_BYTES_PER_SESSION means unlimited.
MAX_SESSIONS=64
MAX_CONNECTIONS_PER_IP=16
MAX_BYTES_PER_SESSION=0
