# Josour relay (ADR-0009), read by docker-compose.relay.yml.
#
#   cp .env.relay.example .env.relay && nano .env.relay
#   docker compose -p josour-relay --env-file .env.relay -f docker-compose.relay.yml up -d --build
#
# Its own file, .env.relay, NOT .env: on a machine that also runs the API, deploy/.env is the
# API's configuration, and copying this over it would wipe the database password and JWT_SECRET.
# Never commit it (keep a copy off the server, as with .env).

# REQUIRED. Byte-identical to RELAY_SECRET in the API's deploy/.env: the API mints the session
# tokens and the relay verifies them. Generate it once with:  openssl rand -hex 32
# Deliberately NOT the same value as JWT_SECRET - that one signs user logins, and a relay is
# internet-facing by definition, so a breach there must not be able to mint access tokens.
RELAY_SECRET=

# The port the apps dial, published on the host. Keep 443 on a dedicated relay host (the one
# outbound port open on essentially every network). On the same machine as the API, Caddy already
# holds 443: use 8443 here and RELAY_PORT=8443 in deploy/.env.
RELAY_PUBLIC_PORT=443

LOG_LEVEL=INFO

# Deadlines (seconds)
PREAMBLE_TIMEOUT_SECONDS=5
PAIR_TIMEOUT_SECONDS=30
IDLE_TIMEOUT_SECONDS=120
MAX_SESSION_SECONDS=7200

# Limits. 0 for MAX_BYTES_PER_SESSION means unlimited.
MAX_SESSIONS=64
MAX_CONNECTIONS_PER_IP=16
MAX_BYTES_PER_SESSION=0
