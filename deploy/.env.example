# انسخ إلى .env وعدّل القيم. لا تُودع .env في git.
DOMAIN=rb.example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=routebridge
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=routebridge

# 48 بايت عشوائية على الأقل: openssl rand -base64 48
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

BACKUP_RETENTION_DAYS=14

# تحديد المعدل وكشف الأجهزة المشبوهة (ADR-0008). القيم أدناه هي الافتراضات؛ احذف أي سطر لتعتمد الافتراضي.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=30
LOGIN_EMAIL_RATE_LIMIT=5
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MINUTES=15
DEVICE_RISK_ENABLED=true
DEVICE_RISK_INTERVAL_SECONDS=300
DEVICE_RISK_WINDOW_MINUTES=60
DEVICE_RISK_SECRET_FAILURES=10
DEVICE_RISK_REFRESH_REUSE=3
