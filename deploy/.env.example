# Copy to .env and set the values. Do not commit .env to git.
DOMAIN=rb.example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=routebridge
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=routebridge

# At least 48 random bytes: openssl rand -base64 48
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

BACKUP_RETENTION_DAYS=14

# Rate limiting and suspicious-device detection (ADR-0008). The values below are the defaults; delete any line to take the default.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=30
LOGIN_EMAIL_RATE_LIMIT=5
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MINUTES=15
DEVICE_RISK_ENABLED=true
DEVICE_RISK_INTERVAL_SECONDS=300
DEVICE_RISK_WINDOW_MINUTES=60
DEVICE_RISK_SECRET_FAILURES=10
DEVICE_RISK_REFRESH_REUSE=3

# --- Relay (ADR-0009) ---------------------------------------------------------
# Where clients dial for the guaranteed transport. Empty = direct-only, which still works
# wherever one side is reachable but is exactly what fails between two mobile networks.
# Deploy the relay separately (docker-compose.relay.yml), ideally in a Gulf region.
RELAY_HOST=
RELAY_PORT=443
# Must be byte-identical to RELAY_SECRET on the relay host: openssl rand -base64 48
# NOT the same value as JWT_SECRET — that one signs user logins.
RELAY_SECRET=
