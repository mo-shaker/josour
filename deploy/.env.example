# Josour server configuration, read by docker-compose.yml (docs/self-hosting.md).
#
#   cp .env.example .env && nano .env
#
# Never commit .env (it is in .gitignore), and keep a copy somewhere other than the server: it
# holds the database password and the signing secret. Generate every secret in this file with
#
#   openssl rand -hex 32
#
# Hex is deliberate: letters and digits only, so a value never needs quoting here and never
# breaks the database URL it is pasted into.

# =================================================================================================
# REQUIRED. `docker compose` refuses to start until each of these has a value.
# =================================================================================================

# The server's public name, e.g. josour.example.com. Its DNS A record must already point at this
# machine: Caddy asks Let's Encrypt for the certificate on the first start, over port 80.
DOMAIN=
# Let's Encrypt sends certificate-expiry notices here.
ACME_EMAIL=

# The database password (openssl rand -hex 32). PostgreSQL stores it when the database volume is
# created, on the very first start: changing it here afterwards does NOT change the database's
# password, it only stops the API from connecting. Set it once, before the first `up`.
POSTGRES_PASSWORD=

# Signs the users' access tokens (openssl rand -hex 32; at least 32 characters, or the API refuses
# to start). Changing it later invalidates every access token in use at once.
JWT_SECRET=

# =================================================================================================
# OPTIONAL. Every line below may be left as it is, or deleted to take the default shown.
# =================================================================================================

# The database's user and name. Leave them: the backup and security scripts read them from here.
POSTGRES_USER=josour
POSTGRES_DB=josour

# --- Relay (ADR-0009) ----------------------------------------------------------------------------
# Where the apps dial for the guaranteed transport. Empty = direct-only, which still works
# wherever one side is reachable from the internet but fails between two mobile networks.
# The relay is a separate stack: docker-compose.relay.yml, with its own .env.relay (see the
# header of that file). On the same machine as this API it is usually RELAY_HOST=<DOMAIN> and
# RELAY_PORT=8443; on a host of its own, that host's name and 443.
RELAY_HOST=
RELAY_PORT=443
# Byte-identical to RELAY_SECRET in .env.relay (openssl rand -hex 32). NOT the same value as
# JWT_SECRET: a relay is internet-facing, and a breach there must not be able to mint sign-ins.
# Setting only one of RELAY_HOST / RELAY_SECRET stops the API at start-up, on purpose.
RELAY_SECRET=

# --- Web dashboard at https://DOMAIN/admin (ADR-0016) --------------------------------------------
# The first administrator is created on the server, once:
#   docker compose exec api python manage.py create-admin --email you@example.com --display-name "You"
# false removes the dashboard altogether (the app and the CLI still work).
ADMIN_WEB_ENABLED=true
# Comma-separated networks allowed to reach it (your office, home or VPN), e.g.
# 203.0.113.0/24,2001:db8::/32. Anyone else gets a 404. Empty = reachable from anywhere.
ADMIN_WEB_ALLOWED_CIDRS=
# true = every administrator must enrol an authenticator app (TOTP) before using the dashboard.
ADMIN_WEB_REQUIRE_TOTP=false
ADMIN_WEB_IDLE_MINUTES=30
ADMIN_WEB_ABSOLUTE_HOURS=12
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Self-registration and contacts (ADR-0014, ADR-0017) -----------------------------------------
# WHETHER people may create their own account from the app is a dashboard setting (Settings →
# Registration from the app: closed / with administrator approval / open; the default is
# approval). These only bound it.
REGISTER_RATE_LIMIT_PER_HOUR=5
INVITE_RATE_LIMIT_PER_DAY=20
MAX_PENDING_REGISTRATIONS=200

# --- Sign-in tokens --------------------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Backups -------------------------------------------------------------------------------------
# The backup service writes deploy/backups/josour-<UTC>.sql.gz once a day and deletes older ones.
BACKUP_RETENTION_DAYS=14

# --- Rate limiting and suspicious-device detection (ADR-0008) ------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=30
LOGIN_EMAIL_RATE_LIMIT=5
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MINUTES=15
# A zero for any threshold disables that rule alone.
DEVICE_RISK_ENABLED=true
DEVICE_RISK_INTERVAL_SECONDS=300
DEVICE_RISK_WINDOW_MINUTES=60
DEVICE_RISK_SECRET_FAILURES=10
DEVICE_RISK_REFRESH_REUSE=3
