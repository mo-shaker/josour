<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12+: the system splash shows the same badge on the canvas; the window behind the app is the plain canvas. -->
  <style name="JosourTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/josour_canvas</item>
    <item name="android:windowSplashScreenBackground">@color/josour_canvas</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:statusBarColor">@color/josour_canvas</item>
    <item name="android:navigationBarColor">@color/josour_surface</item>
    <item name="android:windowLightStatusBar">@bool/josour_light_bars</item>
    <item name="android:windowLightNavigationBar">@bool/josour_light_bars</item>
    <item name="colorPrimary">@color/josour_primary</item>
    <item name="colorAccent">@color/josour_primary</item>
  </style>
</resources>
