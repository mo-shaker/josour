<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Colours come from values/colors.xml and values-night/colors.xml (generated by scripts/mobile-theme.py). -->
  <style name="JosourTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@drawable/splash_window</item>
    <item name="android:statusBarColor">@color/josour_canvas</item>
    <item name="android:navigationBarColor">@color/josour_surface</item>
    <item name="android:windowLightStatusBar">@bool/josour_light_bars</item>
    <item name="colorPrimary">@color/josour_primary</item>
    <item name="colorAccent">@color/josour_primary</item>
  </style>
</resources>
