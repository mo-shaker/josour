<ui:FluentWindow x:Class="RouteBridge.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:RouteBridge.App"
                 xmlns:vm="clr-namespace:RouteBridge.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
                 Title="{x:Static app:Strings.SettingsWindowTitle}"
                 FlowDirection="{x:Static app:UiFlow.Direction}"
                 Language="{x:Static app:UiFlow.Language}"
                 NumberSubstitution.Substitution="European"
                 Icon="pack://application:,,,/Assets/routebridge.ico"
                 Width="480" Height="620" MinWidth="440" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static app:Strings.SettingsWindowTitle}" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,4,20,0">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <ui:TextBlock FontTypography="Title" Text="{x:Static app:Strings.SettingsHeading}" />
                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Margin="0,4,0,16"
                              Text="{x:Static app:Strings.SettingsDescription}" />

                <!-- server -->
                <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static app:Strings.SettingsServerSection}" />
                <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Margin="0,8,0,0"
                              Text="{x:Static app:Strings.SettingsServerUrlLabel}" />
                <!-- A URL is typed left to right whatever the interface language is. -->
                <ui:TextBox Margin="0,4,0,4"
                            FlowDirection="{x:Static app:UiFlow.Technical}"
                            Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{x:Static app:Strings.LoginServerUrlPlaceholder}"
                            Icon="{ui:SymbolIcon Globe24}" />
                <ui:TextBlock Appearance="Tertiary" FontTypography="Caption" TextWrapping="Wrap"
                              Text="{x:Static app:Strings.SettingsServerUrlHint}" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Content="{Binding TestButtonText}" Command="{Binding TestConnectionCommand}" />
                    <ui:ProgressRing Grid.Column="1" IsIndeterminate="True" Width="20" Height="20"
                                     HorizontalAlignment="Left" Margin="12,0,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <ui:InfoBar Margin="0,8,0,0" IsClosable="False"
                            IsOpen="{Binding HasServerMessage, Mode=OneWay}"
                            Severity="{Binding IsServerMessageAnError, Converter={StaticResource ErrorSeverity}}"
                            Message="{Binding ServerMessage}" />

                <!-- interface -->
                <ui:TextBlock FontTypography="BodyStrong" Margin="0,20,0,0" Text="{x:Static app:Strings.SettingsInterfaceSection}" />

                <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Margin="0,8,0,0"
                              Text="{x:Static app:Strings.SettingsLanguageLabel}" />
                <ComboBox Margin="0,4,0,0"
                          ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.Languages}}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          DisplayMemberPath="Display" />
                <ui:InfoBar Margin="0,8,0,0" IsClosable="False" Severity="Informational"
                            IsOpen="{Binding IsLanguageRestartNoteVisible, Mode=OneWay}"
                            Message="{x:Static app:Strings.SettingsLanguageRestartNote}" />

                <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Margin="0,12,0,0"
                              Text="{x:Static app:Strings.SettingsBrowserLabel}" />
                <ComboBox Margin="0,4,0,0"
                          ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.Browsers}}"
                          SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}"
                          DisplayMemberPath="Display" />
                <ui:TextBlock Appearance="Tertiary" FontTypography="Caption" TextWrapping="Wrap" Margin="0,4,0,0"
                              Text="{x:Static app:Strings.SettingsBrowserHint}" />

                <!-- start-up -->
                <ui:TextBlock FontTypography="BodyStrong" Margin="0,20,0,0" Text="{x:Static app:Strings.SettingsStartupSection}" />
                <CheckBox Margin="0,8,0,0"
                          Content="{x:Static app:Strings.SettingsStartWithWindows}"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                          IsEnabled="{Binding IsStartWithWindowsSupported}" />
                <ui:TextBlock Appearance="Tertiary" FontTypography="Caption" Margin="0,2,0,0"
                              Text="{x:Static app:Strings.SettingsStartWithWindowsUnavailable}"
                              Visibility="{Binding IsStartWithWindowsSupported, Converter={StaticResource InverseBoolToVis}}" />
                <CheckBox Margin="0,8,0,0"
                          Content="{x:Static app:Strings.SettingsStartMinimized}"
                          IsChecked="{Binding StartMinimized, Mode=TwoWay}" />

                <ui:InfoBar Margin="0,16,0,0" IsClosable="False" Severity="Error"
                            IsOpen="{Binding HasSaveMessage, Mode=OneWay}"
                            Message="{Binding SaveMessage}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
            <ui:Button MinWidth="100" Content="{x:Static app:Strings.SettingsCancel}" Command="{Binding CancelCommand}" />
            <ui:Button MinWidth="100" Margin="8,0,0,0" Appearance="Primary" IsDefault="True"
                       Content="{x:Static app:Strings.SettingsSave}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
