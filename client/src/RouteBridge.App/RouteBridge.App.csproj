<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>RouteBridge.App</RootNamespace>
    <AssemblyName>RouteBridge</AssemblyName>
    <StartupObject>RouteBridge.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/routebridge.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>RouteBridge</Product>
    <Description>RouteBridge Windows client</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/routebridge.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RouteBridge.Core/RouteBridge.Core.csproj" />
    <ProjectReference Include="../RouteBridge.Infrastructure/RouteBridge.Infrastructure.csproj" />
    <ProjectReference Include="../RouteBridge.Tunnel/RouteBridge.Tunnel.csproj" />
    <ProjectReference Include="../RouteBridge.Proxy/RouteBridge.Proxy.csproj" />
    <ProjectReference Include="../RouteBridge.Egress/RouteBridge.Egress.csproj" />
    <ProjectReference Include="../RouteBridge.Browser/RouteBridge.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="3.1.1" />
  </ItemGroup>

</Project>
