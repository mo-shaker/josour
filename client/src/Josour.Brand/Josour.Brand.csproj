<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Josour identity, shared by the phone (Josour.Mobile) and the desktop (Josour.App): the theme tokens in both colour
    themes, Readex Pro, the logo geometry and the controls that draw it (lock-up, motif, icons). Phase 1 decision 1 in
    docs/design/desktop-phase1-foundation.html. Theme/Tokens.axaml and Controls/BrandGeometry.g.cs are generated by
    scripts/brand-theme.py from docs/design/brand-tokens.json and 1-qantara/.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Josour.Brand</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Theme/**/*.axaml" />
    <!-- Readex Pro, the interface font for Arabic and Latin (BrandFonts.Use), and its licence beside it. -->
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <AvaloniaResource Include="Assets/Fonts/OFL.txt" />
    <EmbeddedResource Include="Assets/Fonts/OFL.txt" LogicalName="Josour.Legal.OFL" />
  </ItemGroup>

</Project>
