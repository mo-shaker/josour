<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADR-0013: one UI on Avalonia for Windows and macOS, in place of WPF.

    It multi-targets for one reason: Windows toast notifications. Microsoft.Toolkit.Uwp.Notifications
    only resolves against a Windows TFM, and dropping it would have taken the Accept/Reject buttons off
    the Windows toast — a capability the port was not asked to spend. Everything else, including every
    view, is built once from the same sources. The plain net8.0 output is what macOS (and Linux) run.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Josour.App</RootNamespace>
    <AssemblyName>Josour</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Josour</Product>
    <Description>Josour desktop client</Description>
    <ApplicationIcon>Assets/josour.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!--
      AVLN3001 warns that a view has no public parameterless constructor, so Avalonia's RUNTIME XAML loader
      could not build one. That is true and intended: every window here is constructed by the container with
      its view model, and giving them parameterless constructors would be adding a way to build a window with
      no view model purely to satisfy a loader this app never uses.
    -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Single-file publishing. Avalonia carries native libraries (libSkiaSharp, libHarfBuzzSharp) that the SDK
    drops beside the exe by default, so an "exe" copied on its own to another machine dies before it can draw
    a window — exactly the failure WPF's native libraries used to cause here. The whole distribution story is
    one file a non-technical user copies and double-clicks, so the flag lives with the project.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Josour.Core/Josour.Core.csproj" />
    <ProjectReference Include="../Josour.Infrastructure/Josour.Infrastructure.csproj" />
    <ProjectReference Include="../Josour.Tunnel/Josour.Tunnel.csproj" />
    <ProjectReference Include="../Josour.Proxy/Josour.Proxy.csproj" />
    <ProjectReference Include="../Josour.Egress/Josour.Egress.csproj" />
    <ProjectReference Include="../Josour.Browser/Josour.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <!-- The live visual tree (F12), debug builds only. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" />
  </ItemGroup>

  <!-- Windows toasts with buttons; see the note at the top. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows10.0.19041.0'">
    <Compile Remove="Services/Notifications/WindowsToastNotifier.cs" />
  </ItemGroup>

</Project>
