<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Josour.App</RootNamespace>
    <AssemblyName>Josour</AssemblyName>
    <StartupObject>Josour.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/josour.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Josour</Product>
    <Description>Josour Windows client</Description>
  </PropertyGroup>

  <!--
    Single-file publishing only. WPF's native libraries (wpfgfx_cor3, PresentationNative_cor3,
    D3DCompiler_47, vcruntime140_cor3) are NOT bundled by default: the SDK drops them beside the
    exe instead, and an "exe" copied on its own to another machine then dies before it can draw a
    window or write a log line - it simply never opens.

    That is not a scenario to guess at: the whole distribution story here is one file that a
    non-technical user copies and double-clicks. So the flag lives with the project, not in
    whoever's shell last built it.

    Both properties are ignored unless -p:PublishSingleFile=true, so CI's framework-dependent
    publish is unaffected. Use scripts/publish-exe.ps1, which checks the result really is one file.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/josour.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Josour.Core/Josour.Core.csproj" />
    <ProjectReference Include="../Josour.Infrastructure/Josour.Infrastructure.csproj" />
    <ProjectReference Include="../Josour.Tunnel/Josour.Tunnel.csproj" />
    <ProjectReference Include="../Josour.Proxy/Josour.Proxy.csproj" />
    <ProjectReference Include="../Josour.Egress/Josour.Egress.csproj" />
    <ProjectReference Include="../Josour.Browser/Josour.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="3.1.1" />
  </ItemGroup>

</Project>
