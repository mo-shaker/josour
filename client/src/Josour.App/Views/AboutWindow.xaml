<ui:FluentWindow x:Class="Josour.App.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Josour.App"
                 xmlns:vm="clr-namespace:Josour.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:AboutViewModel, IsDesignTimeCreatable=False}"
                 Title="{x:Static app:Strings.AboutWindowTitle}"
                 FlowDirection="{x:Static app:UiFlow.Direction}"
                 Language="{x:Static app:UiFlow.Language}"
                 NumberSubstitution.Substitution="European"
                 Icon="pack://application:,,,/Assets/josour.ico"
                 Width="480" SizeToContent="Height" MinHeight="420"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static app:Strings.AboutWindowTitle}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <ui:TextBlock FontTypography="Title" Text="{x:Static app:Strings.AboutHeading}" />
            <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Margin="0,4,0,16"
                          Text="{x:Static app:Strings.AboutDescription}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutAppVersionLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Margin="0,0,0,6" TextWrapping="Wrap" />

                <ui:TextBlock Grid.Row="1" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutDeviceNameLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceName}" Margin="0,0,0,6" TextWrapping="Wrap" />

                <ui:TextBlock Grid.Row="2" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutDeviceIdLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceId}" Margin="0,0,0,6" TextWrapping="Wrap"
                              FontFamily="Consolas, Courier New, monospace" />

                <ui:TextBlock Grid.Row="3" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutOsLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OperatingSystem}" Margin="0,0,0,6" TextWrapping="Wrap" />

                <ui:TextBlock Grid.Row="4" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutServerLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ServerUrl}" Margin="0,0,0,6" TextWrapping="Wrap" />

                <ui:TextBlock Grid.Row="5" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutSignedInLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SignedInAs}" Margin="0,0,0,6" TextWrapping="Wrap" />

                <ui:TextBlock Grid.Row="6" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutConnectionLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ConnectionState}" Margin="0,0,0,6" TextWrapping="Wrap" />

                <ui:TextBlock Grid.Row="7" Grid.Column="0" Appearance="Secondary" Text="{x:Static app:Strings.AboutLogsLabel}" Margin="0,0,12,6" />
                <ui:TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LogDirectory}" Margin="0,0,0,6" TextWrapping="Wrap" />
            </Grid>

            <ui:InfoBar Margin="0,12,0,0" IsClosable="False" Severity="Informational"
                        IsOpen="True" Message="{x:Static app:Strings.AboutSecretsNote}" />

            <ui:InfoBar Margin="0,8,0,0" IsClosable="False"
                        IsOpen="{Binding HasMessage, Mode=OneWay}"
                        Severity="{Binding IsMessageAnError, Converter={StaticResource ErrorSeverity}}"
                        Message="{Binding Message}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,20">
            <ui:Button Content="{x:Static app:Strings.AboutCopy}" Command="{Binding CopyDetailsCommand}" />
            <ui:Button Margin="8,0,0,0" Appearance="Primary"
                       Content="{x:Static app:Strings.AboutOpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
