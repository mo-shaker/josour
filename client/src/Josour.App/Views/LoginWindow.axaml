<Window x:Class="Josour.App.Views.LoginWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Josour.App"
        xmlns:c="https://josour.app/controls"
        mc:Ignorable="d"
        Title="{x:Static app:Strings.LoginWindowTitle}"
        FlowDirection="{x:Static app:UiFlow.Direction}"
        Icon="/Assets/josour.ico"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <!-- The first impression: the lock-up for the interface language, the sign-out reason when there is one, and the fields.
         A URL, an address and a password are typed left to right whatever the interface language is. -->
    <StackPanel Margin="24,20,24,24" Spacing="12" IsEnabled="{Binding IsIdle}">
        <c:BrandLockup Width="190" HorizontalAlignment="Center" AutomationProperties.Name="{x:Static app:Strings.AppName}" />

        <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="{x:Static app:Strings.LoginHeading}" IsVisible="{Binding IsSigningIn}" />
            <TextBlock Classes="title" Text="{x:Static app:Strings.RegisterTitle}" IsVisible="{Binding IsRegistering}" />
            <TextBlock Classes="body secondary" Text="{x:Static app:Strings.MobileLoginDescription}" />
        </StackPanel>

        <c:InfoBar IsClosable="False" Severity="Informational" IsOpen="{Binding HasNotice, Mode=OneWay}"
                   Title="{x:Static app:Strings.SignedOutTitle}" Message="{Binding NoticeText}" />

        <StackPanel Spacing="4">
            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.LoginServerUrlLabel}" />
            <TextBox FlowDirection="{x:Static app:UiFlow.Technical}"
                     Text="{Binding ServerUrl, Mode=TwoWay}"
                     Watermark="{x:Static app:Strings.LoginServerUrlPlaceholder}"
                     AutomationProperties.Name="{x:Static app:Strings.LoginServerUrlLabel}">
                <TextBox.InnerLeftContent>
                    <c:Icon Kind="Server" Classes="sm muted" Margin="10,0,0,0" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.MobileServerUrlHelp}" />
        </StackPanel>

        <!-- Creating an account (ADR-0017): the one extra field. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsRegistering}">
            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.RegisterDisplayName}" />
            <TextBox MaxLength="100" Text="{Binding DisplayName, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.RegisterDisplayName}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.LoginEmailLabel}" />
            <TextBox FlowDirection="{x:Static app:UiFlow.Technical}" Text="{Binding Email, Mode=TwoWay}"
                     AutomationProperties.Name="{x:Static app:Strings.LoginEmailLabel}">
                <TextBox.InnerLeftContent>
                    <c:Icon Kind="Mail" Classes="sm muted" Margin="10,0,0,0" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.LoginPasswordLabel}" />
            <TextBox FlowDirection="{x:Static app:UiFlow.Technical}" PasswordChar="{Binding PasswordChar}" Text="{Binding Password, Mode=TwoWay}"
                     AutomationProperties.Name="{x:Static app:Strings.LoginPasswordLabel}">
                <TextBox.InnerLeftContent>
                    <c:Icon Kind="Key" Classes="sm muted" Margin="10,0,0,0" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Classes="icon" MinHeight="24" MinWidth="28" Margin="0,0,2,0" Command="{Binding TogglePasswordCommand}"
                            ToolTip.Tip="{Binding RevealPasswordName}" AutomationProperties.Name="{Binding RevealPasswordName}">
                        <c:Icon Kind="Eye" Classes="sm" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
            <TextBlock Classes="caption secondary" IsVisible="{Binding IsRegistering}" Text="{x:Static app:Strings.RegisterPasswordHint}" />
        </StackPanel>

        <c:InfoBar IsClosable="False" Severity="Error" IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding ErrorText}"
                   AutomationProperties.LiveSetting="Assertive" />
        <c:InfoBar IsClosable="False" Severity="Informational" IsOpen="{Binding HasInfo, Mode=OneWay}"
                   Title="{x:Static app:Strings.RegisterPendingTitle}" Message="{Binding InfoText}" />

        <Panel>
            <Button Classes="primary large" HorizontalAlignment="Stretch" IsDefault="True"
                    IsVisible="{Binding IsSigningIn}" Content="{Binding SignInButtonText}" Command="{Binding SignInCommand}" />
            <Button Classes="primary large" HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsRegistering}" Content="{x:Static app:Strings.RegisterSubmit}" Command="{Binding RegisterCommand}" />
        </Panel>
        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />

        <Button Classes="link" HorizontalAlignment="Center" Command="{Binding ToggleRegisteringCommand}">
            <Panel>
                <TextBlock IsVisible="{Binding IsSigningIn}" Text="{x:Static app:Strings.LoginCreateAccount}" />
                <TextBlock IsVisible="{Binding IsRegistering}" Text="{x:Static app:Strings.LoginHaveAccount}" />
            </Panel>
        </Button>
    </StackPanel>
</Window>
