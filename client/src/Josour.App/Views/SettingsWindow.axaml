<Window x:Class="Josour.App.Views.SettingsWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:app="clr-namespace:Josour.App"
                 xmlns:c="clr-namespace:Josour.App.Controls"
                 xmlns:vm="clr-namespace:Josour.App.ViewModels"
                 mc:Ignorable="d"
                 Title="{x:Static app:Strings.SettingsWindowTitle}"
                 FlowDirection="{x:Static app:UiFlow.Direction}"
                 Icon="/Assets/josour.ico"
                 Width="480" Height="620" MinWidth="440" MinHeight="520"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,4,20,0">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Classes="title" Text="{x:Static app:Strings.SettingsHeading}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,16"
                              Text="{x:Static app:Strings.SettingsDescription}" />

                <!-- server -->
                <TextBlock Classes="bodyStrong" Text="{x:Static app:Strings.SettingsServerSection}" />
                <TextBlock Classes="caption secondary" Margin="0,8,0,0"
                              Text="{x:Static app:Strings.SettingsServerUrlLabel}" />
                <!-- A URL is typed left to right whatever the interface language is. -->
                <TextBox Margin="0,4,0,4"
                            FlowDirection="{x:Static app:UiFlow.Technical}"
                            Text="{Binding ServerUrl, Mode=TwoWay}"
                            Watermark="{x:Static app:Strings.LoginServerUrlPlaceholder}">
                                <TextBox.InnerLeftContent>
                                    <c:Icon Symbol="Globe" Margin="8,0,2,0" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                <TextBlock Classes="caption tertiary" TextWrapping="Wrap"
                              Text="{x:Static app:Strings.SettingsServerUrlHint}" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding TestButtonText}" Command="{Binding TestConnectionCommand}" />
                    <ProgressBar IsIndeterminate="True" Grid.Column="1" Width="72" Height="4"
                                     HorizontalAlignment="Left" Margin="12,0,0,0"
                                     IsVisible="{Binding IsBusy}" />
                </Grid>

                <c:InfoBar Margin="0,8,0,0" IsClosable="False"
                            IsOpen="{Binding HasServerMessage, Mode=OneWay}"
                            Severity="{Binding IsServerMessageAnError, Converter={StaticResource ErrorSeverity}}"
                            Message="{Binding ServerMessage}" />

                <!-- interface -->
                <TextBlock Classes="bodyStrong" Margin="0,20,0,0" Text="{x:Static app:Strings.SettingsInterfaceSection}" />

                <TextBlock Classes="caption secondary" Margin="0,8,0,0"
                              Text="{x:Static app:Strings.SettingsLanguageLabel}" />
                <ComboBox Margin="0,4,0,0"
                          ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.Languages}}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                <c:InfoBar Margin="0,8,0,0" IsClosable="False" Severity="Informational"
                            IsOpen="{Binding IsLanguageRestartNoteVisible, Mode=OneWay}"
                            Message="{x:Static app:Strings.SettingsLanguageRestartNote}" />

                <CheckBox Margin="0,12,0,0"
                          Content="{x:Static app:Strings.SettingsCheckPageLabel}"
                          IsChecked="{Binding OpenCheckPageOnConnect, Mode=TwoWay}" />
                <TextBlock Classes="caption tertiary" TextWrapping="Wrap" Margin="0,4,0,0"
                              Text="{x:Static app:Strings.SettingsCheckPageHint}" />

                <!-- start-up -->
                <TextBlock Classes="bodyStrong" Margin="0,20,0,0" Text="{x:Static app:Strings.SettingsStartupSection}" />
                <CheckBox Margin="0,8,0,0"
                          Content="{x:Static app:Strings.SettingsStartAtLogin}"
                          IsChecked="{Binding StartAtLogin, Mode=TwoWay}"
                          IsEnabled="{Binding IsStartAtLoginSupported}" />
                <TextBlock Classes="caption tertiary" Margin="0,2,0,0"
                              Text="{x:Static app:Strings.SettingsStartAtLoginUnavailable}"
                              IsVisible="{Binding !IsStartAtLoginSupported}" />
                <CheckBox Margin="0,8,0,0"
                          Content="{x:Static app:Strings.SettingsStartMinimized}"
                          IsChecked="{Binding StartMinimized, Mode=TwoWay}" />

                <!-- Who may use this connection without asking is set per contact now (ADR-0014). -->
                <TextBlock Classes="caption tertiary" TextWrapping="Wrap" Margin="0,20,0,0"
                              Text="{x:Static app:Strings.SettingsTrustMovedHint}" />

                <c:InfoBar Margin="0,16,0,0" IsClosable="False" Severity="Error"
                            IsOpen="{Binding HasSaveMessage, Mode=OneWay}"
                            Message="{Binding SaveMessage}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
            <Button MinWidth="100" Content="{x:Static app:Strings.SettingsCancel}" Command="{Binding CancelCommand}" />
            <Button MinWidth="100" Margin="8,0,0,0" Classes="accent" IsDefault="True"
                       Content="{x:Static app:Strings.SettingsSave}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
