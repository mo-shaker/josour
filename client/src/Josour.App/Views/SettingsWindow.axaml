<Window x:Class="Josour.App.Views.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Josour.App"
        xmlns:c="https://josour.app/controls"
        xmlns:vm="clr-namespace:Josour.App.ViewModels"
        mc:Ignorable="d"
        Title="{x:Static app:Strings.SettingsWindowTitle}"
        FlowDirection="{x:Static app:UiFlow.Direction}"
        Icon="/Assets/josour.ico"
        Width="520" Height="600" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <!-- Grouped in cards; switches for on/off settings; the button bar in each system's order, Enter saves, Esc cancels. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Josour.Brush.Surface}"
                BorderBrush="{DynamicResource Josour.Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <c:PlatformButtonRow>
                <Button MinWidth="100" Classes="primary" IsDefault="True" Content="{x:Static app:Strings.SettingsSave}" Command="{Binding SaveCommand}" />
                <Button MinWidth="100" IsCancel="True" Content="{x:Static app:Strings.SettingsCancel}" Command="{Binding CancelCommand}" />
            </c:PlatformButtonRow>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,20" Spacing="12" IsEnabled="{Binding IsIdle}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="title" Text="{x:Static app:Strings.SettingsHeading}" />
                    <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.SettingsDescription}" />
                </StackPanel>

                <c:Card>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="Server" Classes="sm" />
                            <TextBlock Classes="heading" Text="{x:Static app:Strings.SettingsServerSection}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.SettingsServerUrlLabel}" />
                            <TextBox FlowDirection="{x:Static app:UiFlow.Technical}"
                                     Text="{Binding ServerUrl, Mode=TwoWay}"
                                     Watermark="{x:Static app:Strings.LoginServerUrlPlaceholder}"
                                     AutomationProperties.Name="{x:Static app:Strings.SettingsServerUrlLabel}" />
                            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.MobileServerUrlHelp}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Left" Content="{Binding TestButtonText}" Command="{Binding TestConnectionCommand}" />
                        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />
                        <c:InfoBar IsClosable="False" IsOpen="{Binding HasServerMessage, Mode=OneWay}"
                                   Severity="{Binding IsServerMessageAnError, Converter={StaticResource ErrorSeverity}}"
                                   Message="{Binding ServerMessage}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </c:Card>

                <c:Card>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="Language" Classes="sm" />
                            <TextBlock Classes="heading" Text="{x:Static app:Strings.SettingsInterfaceSection}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.SettingsLanguageLabel}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Static app:Strings.SettingsLanguageLabel}"
                                      ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.Languages}}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                        </StackPanel>
                        <c:InfoBar IsClosable="False" Severity="Informational"
                                   IsOpen="{Binding IsLanguageRestartNoteVisible, Mode=OneWay}"
                                   Message="{x:Static app:Strings.SettingsLanguageRestartNote}" />
                        <Border Classes="divider" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="label" Text="{x:Static app:Strings.SettingsCheckPageLabel}" />
                                <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.SettingsCheckPageHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="12,0,0,0" VerticalAlignment="Top"
                                          IsChecked="{Binding OpenCheckPageOnConnect, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static app:Strings.SettingsCheckPageLabel}" />
                        </Grid>
                    </StackPanel>
                </c:Card>

                <c:Card>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="Clock" Classes="sm" />
                            <TextBlock Classes="heading" Text="{x:Static app:Strings.SettingsStartupSection}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="label" Text="{x:Static app:Strings.SettingsStartAtLogin}" />
                                <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.SettingsStartAtLoginUnavailable}"
                                           IsVisible="{Binding !IsStartAtLoginSupported}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="12,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding StartAtLogin, Mode=TwoWay}" IsEnabled="{Binding IsStartAtLoginSupported}"
                                          AutomationProperties.Name="{x:Static app:Strings.SettingsStartAtLogin}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static app:Strings.SettingsStartMinimized}" />
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="12,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static app:Strings.SettingsStartMinimized}" />
                        </Grid>
                    </StackPanel>
                </c:Card>

                <c:InfoBar IsClosable="False" Severity="Error" IsOpen="{Binding HasSaveMessage, Mode=OneWay}" Message="{Binding SaveMessage}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
