<UserControl x:Class="Josour.App.Views.HostPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:Josour.App"
             xmlns:c="https://josour.app/controls"
             xmlns:vm="clr-namespace:Josour.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="420" d:DesignHeight="420">
    <!--
        The "This device" tab (DataContext: MainViewModel). The Available switch lives in the hero; this tab holds the
        connection's details and the ranked warnings that are not the hero's (Phase 1, "The four warnings, ranked").
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" Margin="0,10,0,14">
            <TextBlock Classes="label" Text="{x:Static app:Strings.MobileYourConnection}" />
            <c:Card Classes="rows">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,10">
                        <c:Icon Kind="Server" Classes="sm muted" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Classes="body" Text="{Binding ServerStatusText}" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="Auto,*" Margin="0,10">
                        <c:Icon Kind="Laptop" Classes="sm muted" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Classes="body" Text="{Binding DeviceNameText}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Host.Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Classes="divider" />
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,10">
                                        <Panel Margin="0,2,12,0" VerticalAlignment="Top">
                                            <c:Icon Kind="Warning" Classes="sm warning" IsVisible="{Binding IsWarning}" />
                                            <c:Icon Kind="Info" Classes="sm info" IsVisible="{Binding IsInfo}" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="label" Text="{Binding Title}" />
                                            <TextBlock Classes="caption" Text="{Binding Message}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:Card>

            <c:Card>
                <Expander Header="{x:Static app:Strings.MobileHowItWorks}" HorizontalAlignment="Stretch" Padding="0,8,0,0"
                          Background="Transparent" BorderThickness="0">
                    <TextBlock Classes="body secondary" Text="{x:Static app:Strings.DesktopHowItWorksText}" />
                </Expander>
            </c:Card>

            <c:Card>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Kind="User" Classes="sm muted" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.AboutSignedInLabel}" />
                        <TextBlock Classes="body" Text="{Binding AccountText}" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding AskSignOutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="SignOut" Classes="sm" />
                            <TextBlock Text="{x:Static app:Strings.TraySignOut}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </c:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
