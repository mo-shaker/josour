<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Josour.App"
        xmlns:c="https://josour.app/controls"
        xmlns:vm="clr-namespace:Josour.App.ViewModels"
        mc:Ignorable="d"
        x:Class="Josour.App.Views.AdminWindow"
        Title="{x:Static app:Strings.AdminWindowTitle}"
        FlowDirection="{x:Static app:UiFlow.Direction}"
        Icon="/Assets/josour.ico"
        Width="760" Height="640" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <!-- User management (administrators only). Each state is a pill with an icon and a word; disabling asks first. -->
    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,20" Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Classes="title" Text="{x:Static app:Strings.AdminHeading}" />
                    <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.AdminDescription}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="{x:Static app:Strings.AdminSearchPlaceholder}"
                             AutomationProperties.Name="{x:Static app:Strings.AdminSearchPlaceholder}">
                        <TextBox.InnerLeftContent>
                            <c:Icon Kind="Search" Classes="sm muted" Margin="10,0,0,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="Refresh" Classes="sm" />
                            <TextBlock Text="{x:Static app:Strings.AdminRefresh}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <c:InfoBar IsClosable="False" IsOpen="{Binding HasMessage}"
                           Severity="{Binding IsMessageAnError, Converter={StaticResource ErrorSeverity}}"
                           Message="{Binding Message}" AutomationProperties.LiveSetting="Polite" />

                <c:Card IsVisible="{Binding IsLoading}">
                    <StackPanel Spacing="8">
                        <Border Classes="skeleton" Width="220" HorizontalAlignment="Left" />
                        <Border Classes="skeleton" Width="320" HorizontalAlignment="Left" />
                        <Border Classes="skeleton" Width="260" HorizontalAlignment="Left" />
                        <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.DesktopAdminLoading}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </c:Card>

                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,12" IsVisible="{Binding ShowsEmpty}">
                    <c:Icon Kind="Search" Classes="muted" HorizontalAlignment="Center" />
                    <TextBlock Classes="body secondary" Text="{x:Static app:Strings.AdminEmptyList}" />
                </StackPanel>

                <c:Card Classes="rows" IsVisible="{Binding HasUsers}">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10">
                                        <Border Classes="avatar" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="label" Text="{Binding DisplayName}" />
                                                <Border Classes="pill neutral" IsVisible="{Binding IsAdmin}" VerticalAlignment="Center">
                                                    <TextBlock Classes="micro" Text="{x:Static app:Strings.AdminRoleAdmin}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="caption secondary" Text="{Binding Email}" />
                                        </StackPanel>
                                        <Panel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border Classes="pill success" IsVisible="{Binding IsStateActive}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <c:Icon Kind="Check" Classes="sm" />
                                                    <TextBlock Classes="micro" Text="{Binding StateText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="pill warning" IsVisible="{Binding IsStateLocked}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <c:Icon Kind="Clock" Classes="sm" />
                                                    <TextBlock Classes="micro" Text="{Binding StateText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="pill neutral" IsVisible="{Binding IsStateDisabled}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <c:Icon Kind="Stop" Classes="sm" />
                                                    <TextBlock Classes="micro" Text="{Binding StateText}" />
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button IsVisible="{Binding CanUnlock}"
                                                    Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <c:Icon Kind="Unlock" Classes="sm" />
                                                    <TextBlock Text="{x:Static app:Strings.AdminUnlock}" />
                                                </StackPanel>
                                            </Button>
                                            <Button MinWidth="88" Content="{Binding ToggleActiveText}" IsEnabled="{Binding CanToggleActive}"
                                                    ToolTip.Tip="{x:Static app:Strings.AdminSelfNote}"
                                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:Card>

                <!-- Creating an account: what manage.py create-user used to be. -->
                <c:Card>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="PersonAdd" Classes="sm" />
                            <TextBlock Classes="heading" Text="{x:Static app:Strings.AdminCreateSection}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.AdminEmailLabel}" />
                                <TextBox FlowDirection="{x:Static app:UiFlow.Technical}" Text="{Binding NewEmail, Mode=TwoWay}"
                                         AutomationProperties.Name="{x:Static app:Strings.AdminEmailLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.AdminDisplayNameLabel}" />
                                <TextBox Text="{Binding NewDisplayName, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.AdminDisplayNameLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.AdminPasswordLabel}" />
                                <TextBox PasswordChar="●" FlowDirection="{x:Static app:UiFlow.Technical}" Text="{Binding NewPassword, Mode=TwoWay}"
                                         AutomationProperties.Name="{x:Static app:Strings.AdminPasswordLabel}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding NewIsAdmin, Mode=TwoWay}">
                                <TextBlock Classes="body" Text="{x:Static app:Strings.AdminMakeAdmin}" />
                            </CheckBox>
                            <Button Grid.Column="1" Classes="primary" MinWidth="110" Content="{x:Static app:Strings.AdminCreate}" Command="{Binding CreateUserCommand}" />
                        </Grid>
                    </StackPanel>
                </c:Card>

                <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />

                <Button Classes="link" HorizontalAlignment="Left" Command="{Binding OpenWebDashboardCommand}" Content="{x:Static app:Strings.AdminOpenWebDashboard}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Disabling cuts the person off at once: asked first, with what it does as the question's text. -->
        <Panel IsVisible="{Binding IsConfirmingDisable}">
            <Border Classes="scrim" />
            <Border Classes="dialog">
                <StackPanel Spacing="12">
                    <TextBlock Classes="heading" Text="{Binding DisableConfirmTitle}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Classes="body" Text="{x:Static app:Strings.AdminDisableWarning}" />
                    <c:PlatformButtonRow>
                        <Button Classes="danger" c:PlatformButtonRow.IsPrimary="True" Content="{x:Static app:Strings.AdminDisable}" Command="{Binding ConfirmDisableCommand}" />
                        <Button IsCancel="True" Content="{x:Static app:Strings.SettingsCancel}" Command="{Binding CancelDisableCommand}" />
                    </c:PlatformButtonRow>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
