<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Josour.App"
        xmlns:c="clr-namespace:Josour.App.Controls"
        xmlns:vm="clr-namespace:Josour.App.ViewModels"
        mc:Ignorable="d"
        x:Class="Josour.App.Views.AdminWindow"
        Title="{x:Static app:Strings.AdminWindowTitle}"
        FlowDirection="{x:Static app:UiFlow.Direction}"
        Icon="/Assets/josour.ico"
        Width="720" Height="660" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="{x:Static app:Strings.AdminHeading}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="{x:Static app:Strings.AdminDescription}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="{x:Static app:Strings.AdminSearchPlaceholder}" />
                <Button Grid.Column="1" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Symbol="ArrowSync" />
                        <TextBlock Text="{x:Static app:Strings.AdminRefresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- The list. Each row states what it is in words; the state is never a colour alone. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Classes="secondary" Margin="0,12,0,0"
                           Text="{x:Static app:Strings.AdminEmptyList}"
                           IsVisible="{Binding !HasUsers}" />

                <ItemsControl ItemsSource="{Binding Users}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:Card Margin="0,0,0,6" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="bodyStrong" Text="{Binding DisplayName}" />
                                            <TextBlock Classes="caption tertiary" VerticalAlignment="Center"
                                                       Text="{x:Static app:Strings.AdminRoleAdmin}"
                                                       IsVisible="{Binding IsAdmin}" />
                                        </StackPanel>
                                        <!-- The email is bidi-isolated by the row, so it reads left to right in Arabic. -->
                                        <TextBlock Classes="caption secondary" Text="{Binding Email}" />
                                        <TextBlock Classes="caption tertiary" Margin="0,2,0,0" Text="{Binding StateText}" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Content="{x:Static app:Strings.AdminUnlock}"
                                            IsVisible="{Binding CanUnlock}"
                                            Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="88"
                                            Content="{Binding ToggleActiveText}"
                                            IsEnabled="{Binding CanToggleActive}"
                                            ToolTip.Tip="{x:Static app:Strings.AdminSelfNote}"
                                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </c:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Creating an account: what manage.py create-user used to be. -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Classes="bodyStrong" Text="{x:Static app:Strings.AdminCreateSection}" />
            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.AdminEmailLabel}" />
                    <TextBox Margin="0,4,0,0"
                             FlowDirection="{x:Static app:UiFlow.Technical}"
                             Text="{Binding NewEmail, Mode=TwoWay}">
                        <TextBox.InnerLeftContent>
                            <c:Icon Symbol="Mail" Margin="8,0,2,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.AdminDisplayNameLabel}" />
                    <TextBox Margin="0,4,0,0" Text="{Binding NewDisplayName, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <TextBlock Classes="caption secondary" Margin="0,8,0,0" Text="{x:Static app:Strings.AdminPasswordLabel}" />
            <TextBox Margin="0,4,0,0" PasswordChar="●"
                     FlowDirection="{x:Static app:UiFlow.Technical}"
                     Text="{Binding NewPassword, Mode=TwoWay}">
                <TextBox.InnerLeftContent>
                    <c:Icon Symbol="Key" Margin="8,0,2,0" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <CheckBox Grid.Column="0"
                          Content="{x:Static app:Strings.AdminMakeAdmin}"
                          IsChecked="{Binding NewIsAdmin, Mode=TwoWay}" />
                <Button Grid.Column="1" Classes="accent" MinWidth="110"
                        Content="{x:Static app:Strings.AdminCreate}"
                        Command="{Binding CreateUserCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <c:InfoBar Margin="0,0,0,8" IsClosable="False" Severity="Warning" IsOpen="True"
                       Message="{x:Static app:Strings.AdminDisableWarning}" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                         IsVisible="{Binding IsBusy}" />
            <c:InfoBar IsClosable="False"
                       IsOpen="{Binding HasMessage}"
                       Severity="{Binding IsMessageAnError, Converter={StaticResource ErrorSeverity}}"
                       Message="{Binding Message}" />
        </StackPanel>
    </Grid>
</Window>
