<UserControl x:Class="Josour.App.Views.GuestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Josour.App"
             xmlns:vm="clr-namespace:Josour.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GuestViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="420" d:DesignHeight="420">
    <Grid Margin="4,12,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="Subtitle" Text="{x:Static app:Strings.GuestPageTitle}" />
                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Margin="0,4,0,0"
                              Text="{x:Static app:Strings.GuestPageDescription}" />
            </StackPanel>
            <ui:Button Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0"
                       Content="{x:Static app:Strings.GuestRefresh}"
                       Command="{Binding RefreshCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Hosts}"
                  SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                  Visibility="{Binding HasHosts, Converter={StaticResource BoolToVis}}">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HostListItem}">
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding UserDisplayName}" />
                            <!-- Device name: a technical identifier, bidi-isolated by the item so it never reorders. -->
                            <ui:TextBlock Appearance="Secondary" Text="{Binding DeviceNameText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{Binding Reachable, Converter={StaticResource ReachabilityBrush}}" />
                            <ui:TextBlock Appearance="Tertiary" FontTypography="Caption"
                                          VerticalAlignment="Center" Text="{Binding ReachabilityText}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding HasHosts, Converter={StaticResource InverseBoolToVis}}">
            <ui:SymbolIcon Symbol="Desktop24" FontSize="40" HorizontalAlignment="Center" Opacity="0.6" />
            <ui:TextBlock FontTypography="BodyStrong" HorizontalAlignment="Center" Margin="0,12,0,4"
                          Text="{Binding EmptyStateTitle}" />
            <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"
                          Text="{Binding EmptyStateText}" />
            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,16,0,0"
                             Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <!-- Pick a length and ask: request.create -->
            <Grid Visibility="{Binding IsWaitingForHost, Converter={StaticResource InverseBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" Appearance="Secondary"
                              Text="{x:Static app:Strings.GuestDurationLabel}" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="120" VerticalAlignment="Center"
                          ItemsSource="{Binding DurationOptions}"
                          SelectedItem="{Binding SelectedDuration, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={x:Static app:Strings.DurationMinutesFormat}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button Grid.Column="2" HorizontalAlignment="Right" Appearance="Primary"
                           Content="{x:Static app:Strings.GuestRequestConnection}"
                           Command="{Binding RequestConnectionCommand}">
                    <ui:Button.Icon>
                        <!-- WPF mirrors layout, not glyphs: an arrow has to be flipped by hand in a right-to-left UI. -->
                        <ui:SymbolIcon Symbol="Send24"
                                       RenderTransformOrigin="0.5,0.5"
                                       RenderTransform="{x:Static app:UiFlow.GlyphMirror}" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <!-- Waiting for request.result -->
            <ui:Card Padding="12" Visibility="{Binding IsWaitingForHost, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="20" Height="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static app:Strings.GuestWaitingTitle}" />
                        <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Text="{Binding WaitingText}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                               Content="{x:Static app:Strings.GuestCancelRequest}"
                               Command="{Binding CancelRequestCommand}" />
                </Grid>
            </ui:Card>

            <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" FontTypography="Caption"
                          Text="{Binding StatusMessage}"
                          Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
