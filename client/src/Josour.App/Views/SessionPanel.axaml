<UserControl x:Class="Josour.App.Views.SessionPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:Josour.App"
             xmlns:c="https://josour.app/controls"
             mc:Ignorable="d"
             d:DesignWidth="420">
    <!--
        The status hero while a session runs (DataContext: MainViewModel). Who, time left, data used, and ending it at the
        top of the window; ending is teal, the safe action (the phone's decision). A guest also gets the proxy note and the
        check page.
    -->
    <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*">
            <c:Motif State="Session" Width="{DynamicResource Josour.Size.MotifEmptyState}" Height="{DynamicResource Josour.Size.MotifEmptyState}" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="heading" Text="{Binding HeroTitle}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Classes="caption secondary" Text="{Binding Session.PeerText}" />
                <TextBlock Classes="caption secondary" Text="{Binding Session.PhaseText}" />
            </StackPanel>
        </Grid>

        <WrapPanel>
            <StackPanel Margin="0,0,28,4" IsVisible="{Binding Session.HasCountdown}">
                <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.MobileSessionTimeLeftLabel}" />
                <TextBlock Classes="display" Text="{Binding Session.TimeLeftText}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,4" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:Icon Kind="Data" Classes="sm muted" />
                    <TextBlock Classes="caption secondary" Text="{x:Static app:Strings.DesktopDataUsedLabel}" />
                </StackPanel>
                <TextBlock Classes="body" Text="{Binding Session.DataUsedText}" />
            </StackPanel>
        </WrapPanel>

        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasAutoNote}">
            <c:Icon Kind="Info" Classes="sm muted" Margin="0,2,8,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding AutoNoteText}" />
        </Grid>

        <c:InfoBar IsClosable="False" Severity="Warning" IsOpen="{Binding Session.IsSameNetworkGuest, Mode=OneWay}"
                   Message="{x:Static app:Strings.SessionSameNetworkWarning}" />
        <c:InfoBar IsClosable="False" Severity="Informational" IsOpen="{Binding Session.IsGuestActive, Mode=OneWay}"
                   Message="{x:Static app:Strings.SessionGuestProxyNote}" />
        <c:InfoBar IsClosable="False" Severity="Warning" IsOpen="{Binding Session.HasNoticeMessage, Mode=OneWay}"
                   Message="{Binding Session.NoticeMessage}" />

        <WrapPanel HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Command="{Binding Session.OpenCheckPageCommand}" IsVisible="{Binding Session.CanOpenCheckPage}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="Link" Classes="sm" />
                    <TextBlock Text="{x:Static app:Strings.SessionOpenCheckPage}" />
                </StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding Session.DisconnectCommand}" IsVisible="{Binding Session.CanDisconnect}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="Stop" Classes="sm" />
                    <TextBlock Text="{x:Static app:Strings.MobileEndSessionNow}" />
                </StackPanel>
            </Button>
        </WrapPanel>
    </StackPanel>
</UserControl>
