<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Josour.App.Converters"
             x:Class="Josour.App.App"
             RequestedThemeVariant="Light">
    <!-- No MainWindow here: App.Initialize builds the Generic Host and the startup flow decides what to show
         (or stays in the tray with the minimized switch). -->
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Josour/Controls/Typography.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Josour/Controls/Icons.axaml" />
                <ResourceInclude Source="avares://Josour/Controls/Icon.axaml" />
                <ResourceInclude Source="avares://Josour/Controls/InfoBar.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Avalonia binds IsVisible to a bool directly and negates with "{Binding !Foo}", so the two
                visibility converters WPF needed are gone. What is left is what actually maps a value.
            -->
            <conv:ReachabilityToBrushConverter x:Key="ReachabilityBrush" />
            <conv:BooleanToInfoBarSeverityConverter x:Key="ErrorSeverity" />
            <conv:WarningFlagToSeverityConverter x:Key="WarningSeverity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
