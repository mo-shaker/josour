<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Josour.Mobile"
             xmlns:c="using:Josour.Mobile.Controls"
             xmlns:v="using:Josour.Mobile.Views"
             xmlns:vm="using:Josour.Mobile.ViewModels"
             x:Class="Josour.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             FontFamily="{StaticResource Josour.Font}"
             Foreground="{DynamicResource Josour.Brush.Text}"
             Background="{DynamicResource Josour.Brush.Canvas}">
  <!--
    The phone's one view (docs/design/mobile-phase2-mockups.html): Starting, then Sign-in, then two tabs - Share and
    Contacts - with the incoming request over everything and two confirmation sheets. Built again on a language switch.
  -->
  <Grid>
    <!-- Starting: the splash's badge in the splash's place; the words come after a moment. -->
    <Grid IsVisible="{Binding IsStarting}">
      <c:SymbolBadge Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{m:Tr AppName}" />
      <StackPanel Classes="delayed" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,220,0,0">
        <TextBlock Classes="body muted center" Text="{m:Tr MobileStarting}" />
        <ProgressBar IsIndeterminate="True" Width="120" />
      </StackPanel>
    </Grid>

    <!-- Visibility sits on a wrapper: on the view itself it would be read from the view's own data context. -->
    <Panel IsVisible="{Binding IsSignedOut}"><v:SignInView DataContext="{Binding SignIn}" /></Panel>

    <!-- Signed in: the page, and the bar that switches pages at thumb height. -->
    <Grid IsVisible="{Binding IsSignedIn}" RowDefinitions="*,Auto">
      <Panel IsVisible="{Binding IsHostPage}"><v:SharePage DataContext="{Binding Host}" /></Panel>
      <Panel IsVisible="{Binding IsContactsPage}"><v:ContactsPage DataContext="{Binding Contacts}" /></Panel>

      <!-- Room for a third tab, "Use a connection" (MobileTabUse), when the phone can be a guest. -->
      <Border Grid.Row="1" Classes="tabbar">
        <Grid ColumnDefinitions="*,*">
          <Button Classes="tab" Classes.selected="{Binding IsHostPage}" HorizontalAlignment="Stretch" Command="{Binding ShowHostCommand}"
                  AutomationProperties.Name="{m:Tr MobileTabShare}">
            <StackPanel Spacing="4">
              <Border Classes="indicator"><c:Icon Kind="Share" /></Border>
              <TextBlock Classes="center" TextWrapping="NoWrap" Text="{m:Tr MobileTabShare}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="tab" Classes.selected="{Binding IsContactsPage}" HorizontalAlignment="Stretch"
                  Command="{Binding ShowContactsCommand}" AutomationProperties.Name="{m:Tr ContactsPageTitle}">
            <StackPanel Spacing="4">
              <Border Classes="indicator">
                <Grid>
                  <c:Icon Kind="People" />
                  <Border Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-16,0"
                          IsVisible="{Binding Contacts.HasIncomingInvites}" AutomationProperties.Name="{Binding Contacts.WaitingText}">
                    <TextBlock Text="{Binding Contacts.IncomingCount}" />
                  </Border>
                </Grid>
              </Border>
              <TextBlock Classes="center" TextWrapping="NoWrap" Text="{m:Tr ContactsPageTitle}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- The incoming request covers everything until it is answered (or, expired, closed). -->
    <Panel IsVisible="{Binding Host.HasIncoming}"><v:RequestView DataContext="{Binding Host.Incoming}" /></Panel>

    <!-- Sign out asks first, and names what stops. -->
    <Grid IsVisible="{Binding IsConfirmingSignOut}">
      <Border Classes="scrim" />
      <Border Classes="sheet">
        <StackPanel Spacing="12">
          <Border Classes="handle" />
          <TextBlock Classes="title" Text="{m:Tr MobileSignOutConfirmTitle}" />
          <TextBlock Classes="body muted" Text="{Binding SignOutConfirmText}" />
          <Grid ColumnDefinitions="*,10,*">
            <Button HorizontalAlignment="Stretch" Command="{Binding CancelSignOutCommand}" Content="{m:Tr SettingsCancel}" />
            <Button Grid.Column="2" Classes="danger" HorizontalAlignment="Stretch" Command="{Binding SignOutCommand}" Content="{m:Tr TraySignOut}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Turning "without asking" on asks first. -->
    <Grid IsVisible="{Binding Contacts.HasTrustCandidate}">
      <Border Classes="scrim" />
      <Border Classes="sheet" DataContext="{Binding Contacts.TrustCandidate}" x:DataType="vm:ContactItem">
        <StackPanel Spacing="12">
          <Border Classes="handle" />
          <TextBlock Classes="title" Text="{Binding TrustConfirmTitle}" />
          <TextBlock Classes="body muted" Text="{m:Tr MobileTrustConfirmText}" />
          <Grid ColumnDefinitions="*,10,*">
            <Button HorizontalAlignment="Stretch" Command="{Binding CancelTrustCommand}" Content="{m:Tr SettingsCancel}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Command="{Binding ConfirmTrustCommand}" Content="{m:Tr MobileTrustAllow}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
