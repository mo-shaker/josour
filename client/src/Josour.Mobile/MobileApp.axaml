<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Josour.Mobile.MobileApp"
             RequestedThemeVariant="Default">
  <!--
    The phone's look (docs/design/mobile-phase1-foundation.html): the generated tokens with Light and Dark values, the
    control themes for buttons, switches, check boxes and banners, then the style classes. Fluent stays underneath with the
    brand teal as its accent; the theme follows the phone's light or dark setting.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Josour.Brand/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://Josour.Mobile/Theme/Metrics.axaml" />
        <ResourceInclude Source="avares://Josour.Mobile/Theme/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Josour.Mobile/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
