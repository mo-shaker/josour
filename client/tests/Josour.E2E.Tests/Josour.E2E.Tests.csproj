<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Josour.Core/Josour.Core.csproj" />
    <ProjectReference Include="../../src/Josour.Tunnel/Josour.Tunnel.csproj" />
    <ProjectReference Include="../../src/Josour.Egress/Josour.Egress.csproj" />
    <ProjectReference Include="../../src/Josour.Proxy/Josour.Proxy.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Proxy أعلى ملفَّق مشترك مع Josour.Proxy.Tests: سلوك واحد لا نسختان تتباعدان -->
    <Compile Include="../Josour.Proxy.Tests/FakeUpstreamProxy.cs" Link="Shared/FakeUpstreamProxy.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- اختبارات تربط مقابس حقيقية وتعتمد مؤقتات: التوازي داخل التجميعة يجعلها متقطعة -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
